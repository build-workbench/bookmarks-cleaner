{
  "show_confidence_indicator": false,
  "ai_settings": {
    "confidence_threshold": 0.4,
    "cache_size": 10000,
    "url_analysis_weight": 15,
    "merge_top_ratio": 0.4
  },
  "llm": {
    "enable": false,
    "provider": "openai",
    "base_url": "https://api.openai.com",
    "model": "gpt-4o-mini",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.0,
    "top_p": 1.0,
    "timeout_seconds": 25,
    "max_retries": 1,
    "prompt": {
      "task_description": "请作为 CleanBook-Agent，精准识别浏览器书签的主题、意图与优先级。",
      "steps": [
        "解析书签标题、URL、域名、上下文，识别核心主题",
        "匹配提供的主/子分类，必要时返回 '未分类' 并说明原因",
        "输出包含 category、confidence、reasons、facets、priority_tags 的 JSON"
      ],
      "scoring_notes": "若分类不确定，请降低置信度并说明疑点；需要人工复核时，在 facets.priority_tags 中加入 'review'。",
      "force_json": true
    }
  },
  "title_cleaning_rules": {
    "prefixes": [
      "登录 |",
      "Sign in ·",
      "登录 "
    ],
    "suffixes": [
      "- V2EX",
      "· GitHub",
      "| Microsoft Learn",
      " - 知乎",
      " - 简书",
      " | 酷 壳 - CoolShell"
    ],
    "replacements": {
      "&": "&",
      "<": "<",
      ">": ">",
      "--- ": "- ",
      "(7条消息)": ""
    }
  },
  "taxonomy": {
    "subjects_file": "taxonomy/subjects.yaml",
    "resource_types_file": "taxonomy/resource_types.yaml"
  },
  "processing_order": [
    "priority_rules",
    "category_rules"
  ],
  "category_order": [
    "🤖 AI",
    "💻 编程",
    "🧬 生物",
    "📚 学习",
    "👥 社区",
    "📰 资讯",
    "🎮 娱乐",
    "📂 其他"
  ],
